@model IEnumerable<CinemaBooking.Models.Combo>

@{
    ViewData["Title"] = "Quản lý Combo (F&B)";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h3 class="fw-bold text-slate-800">Quản lý Combo (F&B)</h3>
        <p class="text-slate-500 small mb-0">Quản lý danh sách đồ ăn, nước uống và các gói combo khuyến mãi.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
        <i class="fas fa-plus"></i>
        Thêm Combo mới
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-slate-50 text-slate-600">
                    <tr>
                        <th class="ps-4 py-3 text-uppercase small fw-bold">Combo</th>
                        <th class="py-3 text-uppercase small fw-bold">Loại</th>
                        <th class="py-3 text-uppercase small fw-bold">Mô tả</th>
                        <th class="py-3 text-uppercase small fw-bold text-center">Giá</th>
                        <th class="pe-4 py-3 text-uppercase small fw-bold text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 py-3">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@item.HinhAnh" alt="@item.TenCombo" 
                                         class="rounded-3 shadow-sm"
                                         style="width: 80px; height: 60px; object-fit: cover;">
                                    <div>
                                        <div class="fw-bold text-slate-800">@item.TenCombo</div>
                                        <div class="text-slate-400 small">ID: #@item.MaCombo</div>
                                    </div>
                                </div>
                            </td>
                            <td class="py-3">
                                @if (item.Loai == "Combo") {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">Combo</span>
                                } else if (item.Loai == "Bắp") {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill">Bắp</span>
                                } else if (item.Loai == "Nước") {
                                    <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill">Nước</span>
                                } else {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill">@item.Loai</span>
                                }
                            </td>
                            <td class="py-3">
                                <div class="text-slate-600 small" style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    @item.MoTa
                                </div>
                            </td>
                            <td class="py-3 text-center">
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                                    @string.Format("{0:N0}đ", item.Gia)
                                </span>
                            </td>
                            <td class="pe-4 py-3 text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.MaCombo" 
                                       class="btn btn-light btn-sm border"
                                       title="Chỉnh sửa">
                                        <i class="fas fa-edit text-slate-600"></i>
                                    </a>
                                    <button type="button" 
                                            class="btn btn-light btn-sm border"
                                            title="Xóa"
                                            onclick="confirmDelete(@item.MaCombo, '@item.TenCombo')">
                                        <i class="fas fa-trash-alt text-danger"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-slate-400">
                                <i class="fas fa-box-open fa-3x mb-3 d-block opacity-25"></i>
                                Chưa có combo nào trong danh sách.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function confirmDelete(id, name) {
        Swal.fire({
            title: 'Xác nhận xóa?',
            text: `Bạn có chắc chắn muốn xóa Combo "${name}" không?`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#E50914',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Có, xóa ngay!',
            cancelButtonText: 'Hủy'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '@Url.Action("Delete", "AdminCombos")',
                    type: 'POST',
                    data: {
                        id: id,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        if (response.success) {
                            Swal.fire('Đã xóa!', response.message, 'success').then(() => {
                                location.reload();
                            });
                        } else {
                            Swal.fire('Lỗi!', response.message, 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Lỗi!', 'Có lỗi xảy ra khi xử lý yêu cầu.', 'error');
                    }
                });
            }
        });
    }
</script>
}
